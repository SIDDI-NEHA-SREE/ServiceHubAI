# ServiceHub AI - Backend Environment Variables
PROJECT_NAME="ServiceHub AI"
API_V1_STR="/api/v1"

# JWT Secret Key (Generate a random 32-character string in production)
SECRET_KEY="servicehub-ai-super-secret-enterprise-jwt-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite for local, PostgreSQL for Supabase)
# SQLite Local: sqlite+aiosqlite:///./servicehub.db
# Supabase Postgres: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="sqlite+aiosqlite:///./servicehub.db"

# Google Gemini API Key (Required for RAG & Ticket Classification)
GEMINI_API_KEY="your-google-gemini-api-key-here"

# CORS Origins
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","https://servicehub-ai.vercel.app"]'
